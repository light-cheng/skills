{
  "name": "light-skills",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Orthogonal agent skill plugins for Claude Code, Codex, and Agent Skills harnesses",
  "repository": {
    "type": "git",
    "url": "https://github.com/light-cheng/skills"
  },
  "license": "MIT",
  "scripts": {
    "check:frontmatter": "node scripts/check-frontmatter.mjs --require-skills",
